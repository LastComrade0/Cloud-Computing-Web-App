{
  "metrics": {
    "append_dimensions": { "InstanceId": "${aws:InstanceId}" },
    "metrics_collected": {
      "cpu": { "measurement": ["cpu_usage_user","cpu_usage_idle","cpu_usage_iowait"], "metrics_collection_interval": 60 },
      "mem": { "measurement": ["mem_used_percent"], "metrics_collection_interval": 60 },
      "disk": { "measurement": ["used_percent"], "resources": ["*"], "metrics_collection_interval": 60 }
    }
  },
  "logs": {
    "logs_collected": {
      "files": { "collect_list": [
        { "file_path": "/var/log/nginx/access.log", "log_group_name": "/midterm/nginx/access", "log_stream_name": "{instance_id}" },
        { "file_path": "/var/log/nginx/error.log",  "log_group_name": "/midterm/nginx/error",  "log_stream_name": "{instance_id}" },
        { "file_path": "/var/log/contact.log",      "log_group_name": "/midterm/contact",      "log_stream_name": "{instance_id}" }
      ] }
    },
    "force_flush_interval": 15
  }
}
